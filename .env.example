# =============================================================================
# Gridwell: Nonogram Picross, Flutter app environment
# =============================================================================
#
# Copy to `.env` and fill in the values. `.env` is gitignored; this template is
# committed and is the full list of what the app reads.
#
# -----------------------------------------------------------------------------
# READ THIS BEFORE ADDING A KEY: .env SHIPS INSIDE THE APP
# -----------------------------------------------------------------------------
#
# `.env` is a Flutter ASSET (pubspec.yaml → flutter → assets), so it is packed
# into the APK/AAB/IPA and anyone can unzip the app and read it. Put ONLY
# values here that are safe to publish:
#
#   SAFE      public client ids, public endpoint URLs
#   NOT SAFE  API keys with write access, tokens, signing keys, service-account
#             files, database credentials
#
# Every key below is required and there are no built-in fallbacks: a missing
# `.env` fails the build (it is a declared asset) and a missing or empty value
# throws at startup.
# =============================================================================


# -----------------------------------------------------------------------------
# Google Sign-In
# -----------------------------------------------------------------------------
# OAuth 2.0 WEB client id of the Firebase project (gridwell-ce717):
# Google Cloud Console → APIs & Services → Credentials → "Web client"
# (also in android/app/google-services.json as the oauth_client with
# client_type 3).
#
# The web client, not the Android one: google_sign_in passes it as the
# serverClientId so Firebase can verify the ID token. Public by design.
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id-here


# -----------------------------------------------------------------------------
# Backend API (host only, no /api/v1: the app adds it)
# -----------------------------------------------------------------------------
# Picked at runtime by build mode: release builds use PROD, debug and profile
# builds use DEV.
#
# To point a debug build at production without editing this file:
#   flutter run --dart-define=API_ENV=prod
#
# DEV must be reachable FROM THE PHONE, so `localhost` will not work (that is
# the phone itself). Use your PC's LAN address with the API's port
# (dotnet run listens on 5141), or 10.0.2.2 for the Android emulator.
DEV_API_BACKEND_URL=http://192.168.0.141:5141

# Public production API.
PROD_API_BACKEND_URL=https://gridwell.pranta.dev
